@model PagedResult<ProductDto>
@{
    ViewData["Title"] = "Tủ Sách & Danh mục Sản phẩm";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
    var currentCategoryId = ViewBag.CurrentCategoryId as Guid?;
    var currentKeyword = ViewBag.CurrentKeyword as string;
}

<div class="row g-4">
    <!-- Cột trái: Bộ lọc danh mục & Giá -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm mb-4 sticky-top" style="top: 80px; z-index: 10;">
            <div class="card-header bg-white py-3 fw-bold">
                <i class="bi bi-funnel text-primary me-2"></i>Bộ lọc tìm kiếm
            </div>
            <div class="card-body">
                <form method="get" asp-action="Books">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Từ khóa</label>
                        <input type="text" name="keyword" value="@currentKeyword" class="form-control form-control-sm" placeholder="Tên sách, tác giả, SKU..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Danh mục thể loại</label>
                        <select name="categoryId" class="form-select form-select-sm">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var c in categories)
                            {
                                <!option value="@c.Id" @(currentCategoryId == c.Id ? "selected" : "")>@c.Name</!option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Khoảng giá</label>
                        <div class="row g-1">
                            <div class="col-6">
                                <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Từ (₫)" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Đến (₫)" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                        <i class="bi bi-search me-1"></i> Áp dụng bộ lọc
                    </button>
                    <a asp-action="Books" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                        Xóa bộ lọc
                    </a>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột phải: Danh sách sản phẩm -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0">Tủ Sách & Văn Phòng Phẩm</h4>
                <small class="text-muted">Hiển thị @(Model?.Items?.Count ?? 0) trên tổng số @(Model?.TotalCount ?? 0) sản phẩm</small>
            </div>
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="card border-0 shadow-sm p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>Không tìm thấy tựa sách hoặc sản phẩm nào phù hợp.</h5>
                <p class="small">Vui lòng thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc.</p>
                <div class="mt-2">
                    <a asp-action="Books" class="btn btn-outline-primary btn-sm">Xem tất cả sách</a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var p in Model.Items)
                {
                    <div class="col-6 col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column">
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                                <div class="bg-light text-center p-3" style="height: 220px; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.Title" style="max-height: 190px; max-width: 100%; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-book-half fs-1 text-secondary opacity-50"></i>
                                    }
                                </div>
                            </a>
                            <div class="card-body p-3 d-flex flex-column">
                                <small class="text-muted mb-1 text-truncate">@p.CategoryName</small>
                                <h6 class="card-title fw-bold text-dark text-truncate mb-2" title="@p.Title">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="text-dark text-decoration-none">@p.Title</a>
                                </h6>
                                <div class="mt-auto pt-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fs-5 fw-bold text-danger">@p.SellingPrice.ToString("N0") ₫</span>
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Thêm vào giỏ">
                                                <i class="bi bi-cart-plus"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Books" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-categoryId="@currentCategoryId" asp-route-keyword="@currentKeyword">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                <a class="page-link" asp-action="Books" asp-route-pageIndex="@i" asp-route-categoryId="@currentCategoryId" asp-route-keyword="@currentKeyword">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Books" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-categoryId="@currentCategoryId" asp-route-keyword="@currentKeyword">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
