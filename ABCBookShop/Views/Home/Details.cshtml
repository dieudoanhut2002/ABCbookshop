@model ProductDto
@{
    ViewData["Title"] = Model.Title;
    var stockAcrossStores = ViewBag.StockAcrossStores as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var totalStock = stockAcrossStores.Values.Sum();
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Books" class="text-decoration-none">Tủ sách</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="row g-4 mb-5">
    <!-- Hình ảnh sản phẩm -->
    <div class="col-md-5 col-lg-4 text-center">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded-3" style="max-height: 400px; object-fit: contain;" />
            }
            else
            {
                <div class="py-5 text-muted">
                    <i class="bi bi-book-half display-1 opacity-50"></i>
                    <p class="mt-2">Ảnh bìa sản phẩm</p>
                </div>
            }
        </div>
    </div>

    <!-- Thông tin chi tiết & Đặt mua -->
    <div class="col-md-7 col-lg-5">
        <span class="badge bg-primary-subtle text-primary mb-2">@Model.CategoryName</span>
        <h2 class="fw-bold mb-2">@Model.Title</h2>
        <div class="text-muted small mb-3">
            <span>Mã SKU: <code>@Model.SKU</code></span> |
            <span>Mã vạch: <code>@Model.Barcode</code></span>
            @if (!string.IsNullOrEmpty(Model.BookDetail?.ISBN))
            {
                <span> | ISBN: <code>@Model.BookDetail.ISBN</code></span>
            }
        </div>

        <div class="fs-2 fw-bold text-danger mb-4">
            @Model.SellingPrice.ToString("N0") ₫
        </div>

        <hr />

        <!-- Form đặt mua -->
        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="row g-2 align-items-center mb-3">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-semibold">Số lượng mua:</label>
                </div>
                <div class="col-auto" style="width: 120px;">
                    <input type="number" name="quantity" class="form-control text-center" value="1" min="1" max="@(totalStock > 0 ? totalStock : 99)" />
                </div>
                <div class="col-auto text-muted small">
                    (@(totalStock > 0 ? $"Còn {totalStock:N0} {Model.Unit} trong toàn hệ thống" : "Tạm hết hàng"))
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg flex-fill fw-bold shadow-sm" @(totalStock <= 0 ? "disabled" : "")>
                    <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ hàng
                </button>
            </div>
        </form>

        <!-- Đặc điểm sách -->
        <div class="card border bg-light">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-card-text text-primary me-2"></i>Thông tin xuất bản & ấn phẩm</h6>
                <div class="row g-2 small">
                    <div class="col-6"><span class="text-muted">Tác giả:</span> <strong>@(Model.BookDetail?.Author ?? "Đang cập nhật")</strong></div>
                    <div class="col-6"><span class="text-muted">Nhà xuất bản:</span> <strong>@(Model.BookDetail?.Publisher ?? "Đang cập nhật")</strong></div>
                    <div class="col-6"><span class="text-muted">Năm XB:</span> <strong>@(Model.BookDetail?.PublicationYear != null ? Model.BookDetail.PublicationYear.Value.ToString() : "---")</strong></div>
                    <div class="col-6"><span class="text-muted">Số trang:</span> <strong>@(Model.BookDetail?.PageCount != null ? Model.BookDetail.PageCount.Value.ToString() : "---")</strong></div>
                    <div class="col-6"><span class="text-muted">Ngôn ngữ:</span> <strong>@(Model.BookDetail?.Language ?? "Tiếng Việt")</strong></div>
                    <div class="col-6"><span class="text-muted">Hình thức:</span> <strong>@(Model.BookDetail?.CoverType ?? "Bìa mềm")</strong></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tồn kho tại các chi nhánh chuỗi -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 fw-bold">
                <i class="bi bi-geo-alt-fill text-danger me-2"></i>Tồn kho tại các Cửa hàng
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush small">
                    @if (!stockAcrossStores.Any())
                    {
                        <li class="list-group-item text-muted text-center py-3">
                            Chưa cập nhật tồn kho chi nhánh
                        </li>
                    }
                    else
                    {
                        @foreach (var kvp in stockAcrossStores)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <i class="bi bi-shop me-1 text-primary"></i>@kvp.Key
                                </div>
                                @if (kvp.Value > 0)
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold">Còn @kvp.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Hết hàng</span>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="card-footer bg-light small text-muted">
                <i class="bi bi-info-circle me-1"></i> Quý khách có thể ghé trực tiếp quầy thu ngân các chi nhánh trên để mua hàng.
            </div>
        </div>
    </div>
</div>

<!-- Giới thiệu nội dung sách -->
<div class="card border-0 shadow-sm p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-file-text text-primary me-2"></i>Mô tả tóm tắt nội dung</h5>
    <div class="text-secondary" style="line-height: 1.8;">
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
        else
        {
            <p class="text-muted">Tác phẩm mang giá trị tri thức sâu sắc, đã được phát hành rộng rãi trên toàn quốc thông qua hệ thống chuỗi nhà sách ABCBookShop.</p>
        }
    </div>
</div>
