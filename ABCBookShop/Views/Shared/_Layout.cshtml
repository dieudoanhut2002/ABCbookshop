<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chuỗi Nhà Sách ABCBookShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ABCBookShop.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-warning d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half fs-4 me-2"></i>ABCBookShop
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Books">
                                <i class="bi bi-book me-1"></i>Tủ sách & Mua sắm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 me-1"></i>Giỏ hàng
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-wide-connected me-1"></i>Quản trị Chuỗi
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="adminMenu">
                                <li>
                                    <a class="dropdown-item fw-bold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2"></i>Executive Dashboard Chuỗi
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-boxes text-primary me-2"></i>Danh mục Sản phẩm & Sách
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Create">
                                        <i class="bi bi-plus-circle text-success me-2"></i>Thêm sản phẩm mới
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/hangfire" target="_blank">
                                        <i class="bi bi-cpu text-danger me-2"></i>Tác vụ nền & Automation (Hangfire)
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="inventoryMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-box-seam me-1"></i>Kho & Sổ cái
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="inventoryMenu">
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                                        <i class="bi bi-clipboard-data text-primary me-2"></i>Tồn kho & Cảnh báo
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="Ledger">
                                        <i class="bi bi-journal-text text-secondary me-2"></i>Sổ cái biến động kho
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="Adjust">
                                        <i class="bi bi-sliders text-warning me-2"></i>Kiểm kê & Điều chỉnh kho
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="Transfers">
                                        <i class="bi bi-arrow-left-right text-info me-2"></i>Chuyển kho liên chi nhánh
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Inventory" asp-action="CreateTransfer">
                                        <i class="bi bi-truck text-success me-2"></i>Tạo lệnh chuyển kho
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="purchasingMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-cart-check me-1"></i>Mua hàng & NCC
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="purchasingMenu">
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Purchasing" asp-action="Index">
                                        <i class="bi bi-receipt text-primary me-2"></i>Phiếu nhập kho (GRN)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Purchasing" asp-action="Create">
                                        <i class="bi bi-plus-square text-success me-2"></i>Lập phiếu nhập mới
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Purchasing" asp-action="Suppliers">
                                        <i class="bi bi-building text-info me-2"></i>Danh bạ NCC & Công nợ AP
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="financeMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-cash-coin me-1"></i>Tài chính & Lương
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="financeMenu">
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Finance" asp-action="ProfitLoss">
                                        <i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo cáo Kết quả Kinh doanh (P&L)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Finance" asp-action="Index">
                                        <i class="bi bi-receipt text-warning me-2"></i>Chi phí Vận hành (OPEX)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Finance" asp-action="Payroll">
                                        <i class="bi bi-people-fill text-success me-2"></i>Tính Lương & Hoa hồng NV
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Finance" asp-action="Categories">
                                        <i class="bi bi-tags text-secondary me-2"></i>Định mức Nhóm chi phí
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item me-2">
                            <a class="btn btn-sm btn-success fw-bold text-white shadow-sm" asp-area="POS" asp-controller="Terminal" asp-action="Index">
                                <i class="bi bi-calculator me-1"></i> BÁN HÀNG POS
                            </a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link text-white small" asp-area="POS" asp-controller="Shift" asp-action="Index">
                                <i class="bi bi-clock-history me-1"></i> Ca thu ngân
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <span class="navbar-text text-light small me-3">
                                <i class="bi bi-shop me-1 text-warning"></i>Chi nhánh: <strong>STORE01 (Quận 1)</strong>
                            </span>
                        </li>
                        <li class="nav-item">
                            <span class="navbar-text text-light small">
                                <i class="bi bi-person-circle me-1 text-info"></i>Xin chào, <strong>Quản trị viên</strong>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <span>&copy; 2026 - <strong>ABCBookShop</strong> - Hệ thống Quản lý Chuỗi Nhà sách & Bán lẻ chuyên nghiệp</span>
            <span class="small text-muted"><i class="bi bi-shield-lock me-1"></i>Phiên bản .NET 8 LTS • Modular Monolith</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
