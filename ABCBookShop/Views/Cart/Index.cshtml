@model ShoppingCartDto
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-gray-800 mb-0"><i class="bi bi-cart3 text-primary me-2"></i>Giỏ Hàng Của Bạn</h2>
        <p class="text-muted small mb-0">Quý khách được miễn phí giao hàng toàn quốc cho đơn hàng từ 250,000 ₫.</p>
    </div>
    <a asp-controller="Home" asp-action="Books" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Tiếp tục chọn sách
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Items.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="bi bi-cart-x fs-1 d-block mb-3"></i>
        <h4>Giỏ hàng của bạn đang trống</h4>
        <p class="small">Hãy dạo quanh nhà sách và chọn cho mình những cuốn sách ưng ý nhất nhé!</p>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Books" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-book me-1"></i> Mua sắm ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Danh sách mặt hàng trong giỏ -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm / Sách</th>
                                <th style="width: 140px;" class="text-end">Đơn giá</th>
                                <th style="width: 160px;" class="text-center">Số lượng</th>
                                <th style="width: 140px;" class="text-end">Thành tiền</th>
                                <th style="width: 50px;" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Title" style="width: 50px; height: 65px; object-fit: contain;" class="rounded me-3 border" />
                                            }
                                            else
                                            {
                                                <div class="rounded me-3 bg-light border d-flex align-items-center justify-content-center" style="width: 50px; height: 65px;">
                                                    <i class="bi bi-book text-muted"></i>
                                                </div>
                                            }
                                            <div>
                                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none">
                                                    @item.Title
                                                </a>
                                                <div class="small text-muted">SKU: <code>@item.SKU</code></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-center">
                                        <form asp-action="UpdateQty" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2">-</button>
                                            <input type="number" class="form-control form-control-sm text-center" style="width: 60px;" value="@item.Quantity" readonly />
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2">+</button>
                                        </form>
                                    </td>
                                    <td class="text-end fw-bold text-danger">@item.LineTotal.ToString("N0") ₫</td>
                                    <td class="text-center">
                                        <form asp-action="RemoveItem" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa khỏi giỏ">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tóm tắt thanh toán -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
                <div class="card-header bg-white py-3 fw-bold">
                    <i class="bi bi-receipt text-primary me-2"></i>Tóm tắt đơn hàng
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <strong class="fs-6">@Model.SubTotal.ToString("N0") ₫</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí giao hàng:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">TỔNG THANH TOÁN:</span>
                        <span class="fs-4 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <a asp-action="Checkout" class="btn btn-danger w-100 py-3 fw-bold fs-5 shadow">
                        <i class="bi bi-credit-card me-1"></i> TIẾN HÀNH ĐẶT HÀNG
                    </a>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Thanh toán an toàn với VietQR hoặc COD khi nhận hàng</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
