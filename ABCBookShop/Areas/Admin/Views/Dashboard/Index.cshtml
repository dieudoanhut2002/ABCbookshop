@model ChainDashboardSummaryDto
@{
    ViewData["Title"] = "Executive Dashboard - Tổng quan Chuỗi Nhà Sách ABCBookShop";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-gray-800 mb-0">Executive Dashboard - Tổng quan Chuỗi Nhà Sách</h2>
        <p class="text-muted small mb-0">Giám sát doanh thu chuỗi thời gian thực, tồn kho, đơn hàng POS/Online và hiệu quả kinh doanh.</p>
    </div>
    <div class="btn-group">
        <a asp-area="POS" asp-controller="Terminal" asp-action="Index" class="btn btn-success fw-bold">
            <i class="bi bi-calculator me-1"></i> Bán hàng POS
        </a>
        <a asp-area="Admin" asp-controller="Finance" asp-action="ProfitLoss" class="btn btn-outline-primary">
            <i class="bi bi-graph-up-arrow me-1"></i> Báo cáo P&L
        </a>
        <a href="/hangfire" target="_blank" class="btn btn-outline-danger">
            <i class="bi bi-cpu me-1"></i> Hangfire Jobs
        </a>
    </div>
</div>

<!-- KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm border-start border-4 border-success h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Doanh thu hôm nay</div>
                <div class="fs-4 fw-bold text-success">@Model.TodayRevenue.ToString("N0") ₫</div>
                <div class="text-muted small">@Model.TodayOrdersCount đơn hoàn tất</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm border-start border-4 border-primary h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Doanh thu tháng này</div>
                <div class="fs-4 fw-bold text-primary">@Model.MonthRevenue.ToString("N0") ₫</div>
                <div class="text-muted small">@Model.MonthOrdersCount đơn trên toàn chuỗi</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm border-start border-4 border-warning h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Cảnh báo sắp hết hàng</div>
                <div class="fs-4 fw-bold text-warning">@Model.LowStockAlertCount mặt hàng</div>
                <div class="text-muted small">
                    <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" asp-route-onlyLowStock="true" class="text-decoration-none text-muted">
                        Xem chi tiết tồn kho &raquo;
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm border-start border-4 border-info h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Tổng giá trị tồn kho chuỗi</div>
                <div class="fs-4 fw-bold text-info">@Model.TotalInventoryValue.ToString("N0") ₫</div>
                <div class="text-muted small">Tính theo giá vốn nhập (COGS)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Hiệu quả kinh doanh theo Cửa hàng -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-shop text-primary me-2"></i>Doanh số theo Chi nhánh Cửa hàng</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã chi nhánh</th>
                            <th>Tên cửa hàng</th>
                            <th class="text-center">Số đơn</th>
                            <th class="text-end">Doanh thu</th>
                            <th class="text-end">Tỷ trọng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.StorePerformances.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Chưa có giao dịch trong tháng.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in Model.StorePerformances)
                            {
                                <tr>
                                    <td><span class="badge bg-dark font-monospace">@s.StoreCode</span></td>
                                    <td class="fw-bold">@s.StoreName</td>
                                    <td class="text-center">@s.OrdersCount</td>
                                    <td class="text-end fw-semibold text-primary">@s.Revenue.ToString("N0") ₫</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary-subtle text-primary">@s.PercentageOfTotal%</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top 10 sản phẩm bán chạy -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Top Sản phẩm Bán Chạy Nhất Tháng</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên sách / Hàng hóa</th>
                            <th class="text-center">Số lượng bán</th>
                            <th class="text-end">Doanh số</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopSellingProducts.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu bán hàng.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model.TopSellingProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 250px;">@p.Title</div>
                                        <small class="text-muted"><code>@p.SKU</code> | @p.CategoryName</small>
                                    </td>
                                    <td class="text-center fw-bold">@p.QuantitySold.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@p.TotalRevenue.ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Đơn hàng phát sinh gần nhất -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Đơn hàng phát sinh gần nhất trên toàn chuỗi</h5>
        <span class="badge bg-secondary">Thời gian thực</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Thời gian</th>
                    <th>Chi nhánh</th>
                    <th>Khách hàng</th>
                    <th class="text-center">Kênh bán</th>
                    <th class="text-end">Giá trị đơn</th>
                    <th class="text-center">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentOrders.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào phát sinh.</td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><span class="badge bg-dark font-monospace">@o.OrderNumber</span></td>
                            <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@o.StoreName</td>
                            <td>@o.CustomerName</td>
                            <td class="text-center">
                                @if (o.Source == OrderSource.Pos)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-shop me-1"></i>Quầy POS</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-globe me-1"></i>Online Web</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-danger">@o.TotalAmount.ToString("N0") ₫</td>
                            <td class="text-center">
                                @if (o.Status == OrderStatus.Completed)
                                {
                                    <span class="badge bg-success">Hoàn tất</span>
                                }
                                else if (o.Status == OrderStatus.PendingPayment)
                                {
                                    <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@o.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
