@model PagedResult<StockTransactionDto>
@{
    ViewData["Title"] = "Sổ Cái Biến Động Kho (Double-Entry Ledger)";
    var warehouses = ViewBag.Warehouses as List<WarehouseDto> ?? new List<WarehouseDto>();
    Guid? currentWarehouseId = ViewBag.CurrentWarehouseId;
    Guid? currentProductId = ViewBag.CurrentProductId;
    string? currentFromDate = ViewBag.CurrentFromDate;
    string? currentToDate = ViewBag.CurrentToDate;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="text-primary mb-0"><i class="bi bi-journal-bookmark-fill me-2"></i>Sổ Cái Biến Động Kho (Inventory Ledger)</h3>
            <small class="text-muted">Nhật ký bất biến ghi nhận mọi biến động xuất, nhập, chuyển kho và đối soát kiểm kê toàn chuỗi</small>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-box-seam me-1"></i>Xem bảng tồn kho tức thời
            </a>
        </div>
    </div>

    <!-- Bộ lọc Sổ cái -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Ledger" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="warehouseId" class="form-select">
                        <option value="">-- Tất cả kho --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id" selected="@(currentWarehouseId == wh.Id)">@wh.Name (@wh.StoreName)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" value="@currentFromDate" class="form-control" title="Từ ngày" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" value="@currentToDate" class="form-control" title="Đến ngày" />
                </div>
                <div class="col-md-3 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-funnel me-1"></i>Tra cứu</button>
                    <a asp-action="Ledger" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Sổ cái kép -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th class="ps-3" style="width: 150px;">Thời gian</th>
                            <th>Kho thực hiện</th>
                            <th>Mã chứng từ</th>
                            <th>Loại biến động</th>
                            <th>Sản phẩm / SKU</th>
                            <th class="text-end">Tồn trước</th>
                            <th class="text-end">Số lượng biến động</th>
                            <th class="text-end">Tồn sau</th>
                            <th class="text-end">Đơn giá vốn</th>
                            <th>Ghi chú / Diễn giải</th>
                            <th class="pe-3">Người tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                    Không có phát sinh giao dịch kho nào trong kỳ tra cứu.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                var isIncrease = item.Quantity > 0;
                                <tr>
                                    <td class="ps-3 small font-monospace">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@item.WarehouseName</td>
                                    <td>
                                        <span class="font-monospace fw-semibold text-primary">@item.DocumentNo</span>
                                    </td>
                                    <td>
                                        <span class="badge @(isIncrease ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                            @item.TransactionTypeName
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.ProductTitle</div>
                                        <small class="text-muted font-monospace">SKU: @item.ProductSKU</small>
                                    </td>
                                    <td class="text-end font-monospace text-muted">@item.BeforeStock.ToString("N0")</td>
                                    <td class="text-end font-monospace fw-bold @(isIncrease ? "text-success" : "text-danger") fs-6">
                                        @(isIncrease ? "+" : "")@item.Quantity.ToString("N0")
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-dark">@item.AfterStock.ToString("N0")</td>
                                    <td class="text-end font-monospace text-muted">@item.UnitCost.ToString("N0") đ</td>
                                    <td class="small text-muted">@item.Note</td>
                                    <td class="pe-3 small text-secondary"><i class="bi bi-person me-1"></i>@item.CreatedBy</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">
                    Hiển thị <strong>@((Model.PageIndex - 1) * Model.PageSize + 1)</strong> đến <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount))</strong> trong <strong>@Model.TotalCount</strong> giao dịch sổ cái
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Ledger"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-warehouseId="@currentWarehouseId"
                               asp-route-productId="@currentProductId"
                               asp-route-fromDate="@currentFromDate"
                               asp-route-toDate="@currentToDate">Trước</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Ledger"
                                   asp-route-pageIndex="@p"
                                   asp-route-warehouseId="@currentWarehouseId"
                                   asp-route-productId="@currentProductId"
                                   asp-route-fromDate="@currentFromDate"
                                   asp-route-toDate="@currentToDate">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Ledger"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-warehouseId="@currentWarehouseId"
                               asp-route-productId="@currentProductId"
                               asp-route-fromDate="@currentFromDate"
                               asp-route-toDate="@currentToDate">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
