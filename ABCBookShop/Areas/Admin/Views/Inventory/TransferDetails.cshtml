@model TransferOrderDto
@{
    ViewData["Title"] = "Chi tiết Phiếu Chuyển Kho: " + Model.TransferCode;
}

<div class="container-fluid py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Transfers">Danh sách chuyển kho</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TransferCode</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary mb-0">
                <i class="bi bi-box-arrow-up-right me-2"></i>Phiếu Chuyển Kho: @Model.TransferCode
            </h3>
            <small class="text-muted">Từ: <strong>@Model.FromWarehouseName</strong> ➔ Đến: <strong>@Model.ToWarehouseName</strong></small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Transfers" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Timeline Quy trình -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 bg-light rounded">
            <div class="row text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border border-2 border-primary">
                        <div class="fw-bold text-primary fs-5"><i class="bi bi-file-earmark-plus me-1"></i>Bước 1: Lập phiếu</div>
                        <small class="text-muted d-block mt-1">Người tạo: <strong>@Model.CreatedBy</strong></small>
                        <small class="font-monospace text-secondary">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border border-2 @(Model.Status >= TransferStatus.Dispatched ? "border-warning" : "border-secondary-subtle opacity-50")">
                        <div class="fw-bold @(Model.Status >= TransferStatus.Dispatched ? "text-warning" : "text-muted") fs-5">
                            <i class="bi bi-truck me-1"></i>Bước 2: Xuất vận chuyển
                        </div>
                        @if (Model.DispatchedAt.HasValue)
                        {
                            <small class="text-muted d-block mt-1">Xuất bởi: <strong>@Model.DispatchedBy</strong></small>
                            <small class="font-monospace text-secondary">@Model.DispatchedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        }
                        else
                        {
                            <small class="text-muted d-block mt-1">Chờ kho gửi xuất hàng</small>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded border border-2 @(Model.Status == TransferStatus.Received ? "border-success" : "border-secondary-subtle opacity-50")">
                        <div class="fw-bold @(Model.Status == TransferStatus.Received ? "text-success" : "text-muted") fs-5">
                            <i class="bi bi-check-circle me-1"></i>Bước 3: Nhập kho đích
                        </div>
                        @if (Model.ReceivedAt.HasValue)
                        {
                            <small class="text-muted d-block mt-1">Nhận bởi: <strong>@Model.ReceivedBy</strong></small>
                            <small class="font-monospace text-secondary">@Model.ReceivedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        }
                        else
                        {
                            <small class="text-muted d-block mt-1">Chờ kho nhận kiểm đếm</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách mặt hàng & Form xử lý -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 text-dark">
                <i class="bi bi-boxes me-2 text-primary"></i>Danh Sách Mặt Hàng Điều Chuyển
            </h5>
            <span class="badge bg-secondary font-monospace fs-6">Tổng số: @Model.TotalQuantity.ToString("N0") sản phẩm</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Status == TransferStatus.Dispatched)
            {
                <!-- Form Xác nhận nhận hàng tại kho đích -->
                <form method="post" asp-action="Receive" asp-route-id="@Model.Id" onsubmit="return confirm('Bạn có chắc chắn đã kiểm đếm thực tế và xác nhận nhập kho?');">
                    @Html.AntiForgeryToken()
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã SKU</th>
                                    <th>Tên sản phẩm</th>
                                    <th>ĐVT</th>
                                    <th class="text-center">Số lượng yêu cầu</th>
                                    <th class="text-center">Số lượng đã xuất</th>
                                    <th class="text-center" style="width: 200px;">Thực nhận tại kho đích</th>
                                    <th class="pe-3">Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold font-monospace">@item.ProductSKU</td>
                                        <td class="fw-semibold">@item.ProductTitle</td>
                                        <td>@item.Unit</td>
                                        <td class="text-center font-monospace">@item.RequestedQuantity.ToString("N0")</td>
                                        <td class="text-center font-monospace fw-bold text-warning">@item.DispatchedQuantity.ToString("N0")</td>
                                        <td class="text-center">
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="1" name="receivedQuantities[@item.ProductId]"
                                                       value="@item.DispatchedQuantity" max="@item.DispatchedQuantity" min="0"
                                                       class="form-control text-center font-monospace fw-bold text-success fs-6" required />
                                                <span class="input-group-text">@item.Unit</span>
                                            </div>
                                        </td>
                                        <td class="pe-3 small text-muted">Kiểm đếm và nhập số lượng thực tế nhận được</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-light p-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-success px-4 py-2 fs-6">
                            <i class="bi bi-box-arrow-in-down me-1"></i>Xác Nhận Đã Nhận Hàng & Nhập Kho
                        </button>
                    </div>
                </form>
            }
            else
            {
                <!-- Bảng hiển thị thông thường -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã SKU</th>
                                <th>Tên sản phẩm</th>
                                <th>ĐVT</th>
                                <th class="text-center">Tồn tại kho gửi</th>
                                <th class="text-center">Số lượng yêu cầu</th>
                                <th class="text-center">Số lượng đã xuất</th>
                                <th class="text-center">Số lượng đã nhận</th>
                                <th class="pe-3">Đối soát hao hụt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold font-monospace">@item.ProductSKU</td>
                                    <td class="fw-semibold">@item.ProductTitle</td>
                                    <td>@item.Unit</td>
                                    <td class="text-center font-monospace text-muted">@item.CurrentStockAtSource.ToString("N0")</td>
                                    <td class="text-center font-monospace fw-bold">@item.RequestedQuantity.ToString("N0")</td>
                                    <td class="text-center font-monospace text-warning">@item.DispatchedQuantity.ToString("N0")</td>
                                    <td class="text-center font-monospace text-success fw-bold">@item.ReceivedQuantity.ToString("N0")</td>
                                    <td class="pe-3">
                                        @if (!string.IsNullOrWhiteSpace(item.DiscrepancyNote))
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@item.DiscrepancyNote</span>
                                        }
                                        else if (Model.Status == TransferStatus.Received)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Đầy đủ 100%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Status == TransferStatus.Draft)
                {
                    <div class="card-footer bg-light p-3 d-flex justify-content-end">
                        <form method="post" asp-action="Dispatch" asp-route-id="@Model.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xuất hàng khỏi kho gửi để vận chuyển?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning px-4 py-2 fs-6 text-dark fw-bold">
                                <i class="bi bi-truck me-1"></i>Xuất Kho Vận Chuyển (Dispatch)
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>
</div>
