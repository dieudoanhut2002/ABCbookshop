@model List<TransferOrderDto>
@{
    ViewData["Title"] = "Quản lý Luân Chuyển Hàng Liên Chi Nhánh";
    var warehouses = ViewBag.Warehouses as List<WarehouseDto> ?? new List<WarehouseDto>();
    Guid? currentFromWarehouseId = ViewBag.CurrentFromWarehouseId;
    Guid? currentToWarehouseId = ViewBag.CurrentToWarehouseId;
    TransferStatus? currentStatus = ViewBag.CurrentStatus;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="text-primary mb-0"><i class="bi bi-arrow-left-right me-2"></i>Luân Chuyển Hàng Liên Kho / Chi Nhánh</h3>
            <small class="text-muted">Theo dõi quy trình điều chuyển 3 bước: Dự thảo -> Xuất kho (In-Transit) -> Nhận nhập kho</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateTransfer" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Lập phiếu điều chuyển mới
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-box-seam me-1"></i>Xem tồn kho
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Transfers" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="fromWarehouseId" class="form-select">
                        <option value="">-- Kho gửi --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id" selected="@(currentFromWarehouseId == wh.Id)">@wh.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="toWarehouseId" class="form-select">
                        <option value="">-- Kho nhận --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id" selected="@(currentToWarehouseId == wh.Id)">@wh.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- Trạng thái phiếu --</option>
                        <option value="1" selected="@(currentStatus == TransferStatus.Draft)">Chờ xuất chuyển (Dự thảo)</option>
                        <option value="2" selected="@(currentStatus == TransferStatus.Dispatched)">Đang vận chuyển (In-Transit)</option>
                        <option value="3" selected="@(currentStatus == TransferStatus.Received)">Đã nhận nhập kho</option>
                        <option value="4" selected="@(currentStatus == TransferStatus.Cancelled)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-funnel me-1"></i>Lọc</button>
                    <a asp-action="Transfers" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Mã phiếu chuyển</th>
                            <th>Kho xuất gửi</th>
                            <th>Kho nhập nhận</th>
                            <th class="text-center">Số mặt hàng</th>
                            <th class="text-center">Tổng số lượng</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Thời gian tạo</th>
                            <th class="pe-3 text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không có phiếu luân chuyển hàng hóa nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold font-monospace text-primary">@item.TransferCode</td>
                                    <td><i class="bi bi-arrow-up-right text-danger me-1"></i>@item.FromWarehouseName</td>
                                    <td><i class="bi bi-arrow-down-left text-success me-1"></i>@item.ToWarehouseName</td>
                                    <td class="text-center font-monospace">@item.TotalItemsCount mặt hàng</td>
                                    <td class="text-center font-monospace fw-bold fs-6">@item.TotalQuantity.ToString("N0")</td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case TransferStatus.Draft:
                                                <span class="badge bg-secondary p-2"><i class="bi bi-pencil me-1"></i>Dự thảo</span>
                                                break;
                                            case TransferStatus.Dispatched:
                                                <span class="badge bg-warning text-dark p-2"><i class="bi bi-truck me-1"></i>Đang đi đường (In-Transit)</span>
                                                break;
                                            case TransferStatus.Received:
                                                <span class="badge bg-success p-2"><i class="bi bi-check2-circle me-1"></i>Đã nhận kho</span>
                                                break;
                                            case TransferStatus.Cancelled:
                                                <span class="badge bg-dark p-2">Đã hủy</span>
                                                break;
                                        }
                                    </td>
                                    <td class="small font-monospace">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center pe-3">
                                        <a asp-action="TransferDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Chi tiết & Xử lý
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
