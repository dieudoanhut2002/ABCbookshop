@model List<StaffPayrollSlipDto>
@{
    ViewData["Title"] = "Bảng Tính Lương & Hoa Hồng Bán Hàng Nhân Viên";
    var stores = ViewBag.Stores as List<Store> ?? new List<Store>();
    var currentStoreId = ViewBag.CurrentStoreId as Guid?;
    var currentMonth = (int)ViewBag.CurrentMonth;
    var currentYear = (int)ViewBag.CurrentYear;

    var totalBase = Model?.Sum(s => s.BaseSalary) ?? 0;
    var totalSales = Model?.Sum(s => s.SalesRevenueGenerated) ?? 0;
    var totalCommission = Model?.Sum(s => s.CommissionAmount) ?? 0;
    var totalNet = Model?.Sum(s => s.NetSalary) ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-gray-800 mb-0">Bảng Tính Lương & Hoa Hồng Nhân Viên (Payroll)</h2>
        <p class="text-muted small mb-0">Tự động tính lương cơ bản, hoa hồng doanh số bán hàng POS tại quầy (1%), phụ cấp và thực lĩnh.</p>
    </div>
    <div class="btn-group">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-receipt me-1"></i> Quản lý Chi phí OPEX
        </a>
        <a asp-action="ProfitLoss" class="btn btn-outline-primary">
            <i class="bi bi-graph-up-arrow me-1"></i> Báo cáo P&L
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="storeId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả cửa hàng --</option>
                    @foreach (var s in stores)
                    {
                        <!option value="@s.Id" @(currentStoreId == s.Id ? "selected" : "")>@s.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <!option value="@m" @(currentMonth == m ? "selected" : "")>Tháng @m</!option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int y = 2024; y <= 2027; y++)
                    {
                        <!option value="@y" @(currentYear == y ? "selected" : "")>Năm @y</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-calculator me-1"></i> Tính bảng lương
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-4 border-secondary">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Tổng quỹ lương cơ bản</div>
                <div class="fs-4 fw-bold text-dark">@totalBase.ToString("N0") ₫</div>
                <div class="text-muted small">@(Model?.Count ?? 0) nhân viên</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-4 border-info">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Doanh số POS phát sinh</div>
                <div class="fs-4 fw-bold text-info">@totalSales.ToString("N0") ₫</div>
                <div class="text-muted small">Hóa đơn hoàn tất</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Hoa hồng bán hàng (1%)</div>
                <div class="fs-4 fw-bold text-warning">@totalCommission.ToString("N0") ₫</div>
                <div class="text-muted small">Thưởng thành tích</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-4 border-success">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold">Tổng chi trả thực lĩnh</div>
                <div class="fs-4 fw-bold text-success">@totalNet.ToString("N0") ₫</div>
                <div class="text-muted small">Lương + Thưởng + Phụ cấp</div>
            </div>
        </div>
    </div>
</div>

<!-- Payroll Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Bảng Lương Tháng @currentMonth/@currentYear
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Cửa hàng</th>
                    <th class="text-end">Lương cơ bản</th>
                    <th class="text-end">Doanh số POS</th>
                    <th class="text-end">Hoa hồng (1%)</th>
                    <th class="text-end">Phụ cấp</th>
                    <th class="text-end">Khấu trừ</th>
                    <th class="text-end">Lương thực lĩnh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            Chưa có dữ liệu nhân viên.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark font-monospace">@s.StaffCode</span></td>
                            <td class="fw-bold">@s.StaffName</td>
                            <td><span class="badge bg-secondary">@s.StoreName</span></td>
                            <td class="text-end">@s.BaseSalary.ToString("N0") ₫</td>
                            <td class="text-end text-primary fw-semibold">@s.SalesRevenueGenerated.ToString("N0") ₫</td>
                            <td class="text-end text-warning fw-bold">@s.CommissionAmount.ToString("N0") ₫</td>
                            <td class="text-end text-muted">+@s.Allowances.ToString("N0") ₫</td>
                            <td class="text-end text-danger">-@s.Deductions.ToString("N0") ₫</td>
                            <td class="text-end fw-bold text-success fs-6">@s.NetSalary.ToString("N0") ₫</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
