@{
    ViewData["Title"] = "Màn hình Thu ngân Bán hàng POS";
    var shift = ViewBag.ActiveShift as ShiftDetailDto;
    var register = ViewBag.Register as POSRegister;
    var warehouse = ViewBag.Warehouse as Warehouse;
    var registers = ViewBag.Registers as List<POSRegister> ?? new List<POSRegister>();
}

<style>
    .pos-screen {
        height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
    }
    .pos-cart-table th, .pos-cart-table td {
        vertical-align: middle;
        padding: 0.5rem;
    }
    .pos-search-result {
        max-height: 280px;
        overflow-y: auto;
        position: absolute;
        z-index: 1050;
        width: 100%;
    }
    .keyboard-shortcut {
        border: 1px solid rgba(0,0,0,0.15);
        border-radius: 4px;
        padding: 2px 5px;
        font-size: 11px;
        background: #f8f9fa;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-3 pos-screen">
    <!-- POS Top Header Bar -->
    <div class="row bg-dark text-white py-2 px-3 rounded-top align-items-center mb-2">
        <div class="col-md-4 d-flex align-items-center">
            <span class="badge bg-success me-2 fs-6"><i class="bi bi-broadcast me-1"></i>POS ONLINE</span>
            <div>
                <strong class="text-warning">@register?.RegisterCode</strong> - @register?.Name
                <small class="text-white-50 d-block">Kho: @warehouse?.Name</small>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <span class="badge bg-secondary font-monospace">@shift?.ShiftCode</span>
            <small class="d-block text-white-50">Thu ngân: <strong>@shift?.StaffName</strong></small>
        </div>
        <div class="col-md-4 text-end">
            <span class="me-3 font-monospace" id="posClock">00:00:00</span>
            <a asp-area="POS" asp-controller="Shift" asp-action="Close" asp-route-id="@shift?.Id" class="btn btn-sm btn-warning fw-semibold">
                <i class="bi bi-lock me-1"></i> Đóng ca & Kiểm két
            </a>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="row flex-grow-1 g-2 overflow-hidden">
        <!-- Cột trái: Tìm kiếm sản phẩm & Giỏ hàng -->
        <div class="col-lg-8 d-flex flex-direction-column flex-column h-100">
            <!-- Thanh quét mã vạch & Tìm kiếm nhanh -->
            <div class="card border-0 shadow-sm mb-2">
                <div class="card-body p-2 position-relative">
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white">
                            <i class="bi bi-upc-scan fs-5"></i>
                        </span>
                        <input type="text" id="barcodeScannerInput" class="form-control form-control-lg fw-bold"
                               placeholder="Quét mã vạch (Barcode/ISBN) hoặc gõ SKU, tên sách rồi nhấn Enter... [F2]"
                               autofocus autocomplete="off" />
                        <button class="btn btn-primary px-3" type="button" id="btnSearchProduct">
                            <i class="bi bi-search me-1"></i> Tìm hàng
                        </button>
                    </div>

                    <!-- Live search dropdown suggestions -->
                    <div id="searchDropdown" class="pos-search-result card shadow d-none">
                        <div class="list-group list-group-flush" id="searchResultList"></div>
                    </div>
                </div>
            </div>

            <!-- Bảng giỏ hàng -->
            <div class="card border-0 shadow-sm flex-grow-1 overflow-auto">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-cart3 text-primary me-1"></i>Giỏ hàng bán lẻ (<span id="cartCountBadge">0</span> mặt hàng)</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearCart()">
                        <i class="bi bi-trash3 me-1"></i> Làm trống giỏ
                    </button>
                </div>
                <div class="table-responsive h-100">
                    <table class="table table-hover pos-cart-table mb-0" id="cartTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 40px;" class="text-center">#</th>
                                <th>Sản phẩm / Sách</th>
                                <th style="width: 140px;" class="text-end">Đơn giá</th>
                                <th style="width: 150px;" class="text-center">Số lượng</th>
                                <th style="width: 120px;" class="text-end">Giảm/Món</th>
                                <th style="width: 150px;" class="text-end">Thành tiền</th>
                                <th style="width: 50px;" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="cartTableBody">
                            <tr id="emptyCartRow">
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                                    Giỏ hàng đang trống. Vui lòng quét mã vạch sản phẩm để thêm vào đơn.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cột phải: Khách hàng & Thanh toán -->
        <div class="col-lg-4 d-flex flex-column h-100">
            <!-- Box Khách hàng & Tích điểm -->
            <div class="card border-0 shadow-sm mb-2">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-uppercase"><i class="bi bi-person-badge text-primary me-1"></i>Khách hàng thành viên [F4]</span>
                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#quickCustomerModal">
                            + Khách mới
                        </button>
                    </div>
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" id="customerPhoneInput" class="form-control" placeholder="Nhập SĐT khách hàng..." />
                        <button class="btn btn-outline-primary" type="button" onclick="searchCustomer()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div id="customerInfoBox" class="bg-light p-2 rounded small d-none">
                        <div class="d-flex justify-content-between">
                            <strong id="custNameText">Nguyễn Văn A</strong>
                            <span class="badge bg-warning text-dark" id="custTierBadge">Gold</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted">
                            <span>SĐT: <span id="custPhoneText">090...</span></span>
                            <span>Điểm: <strong class="text-primary" id="custPointsText">0</strong> điểm</span>
                        </div>
                        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2">
                            <span class="text-muted">Đổi điểm:</span>
                            <input type="number" id="redeemPointsInput" class="form-control form-control-sm text-end" style="width: 90px;" min="0" value="0" oninput="onRedeemPointsChange()" />
                            <small class="text-muted">= <span id="redeemValueText">0 ₫</span></small>
                            <button type="button" class="btn btn-sm btn-link text-danger ms-auto p-0" onclick="clearCustomer()">Bỏ chọn</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Box Tổng quan đơn hàng & Thanh toán -->
            <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column">
                <div class="card-body p-3 flex-grow-1 d-flex flex-column">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>Tổng tiền hàng:</span>
                            <span class="fw-semibold text-dark" id="subTotalText">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>Giảm giá trực tiếp:</span>
                            <div class="d-flex align-items-center gap-1">
                                <input type="number" id="directDiscountInput" class="form-control form-control-sm text-end" style="width: 100px;" min="0" step="1000" value="0" oninput="recalculateTotals()" />
                                <span>₫</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between text-muted mb-1">
                            <span>Giảm từ điểm thưởng:</span>
                            <span class="text-danger fw-semibold" id="loyaltyDiscountText">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <span class="fs-5 fw-bold text-dark">KHÁCH PHẢI TRẢ:</span>
                            <span class="fs-3 fw-bold text-primary" id="finalTotalText">0 ₫</span>
                        </div>
                    </div>

                    <hr class="my-2" />

                    <!-- Phương thức thanh toán -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-uppercase text-muted">Phương thức thanh toán</label>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="payTypeRadio" id="payCashRadio" value="Cash" checked onchange="onPaymentTypeChange()" />
                            <label class="btn btn-outline-success btn-sm" for="payCashRadio"><i class="bi bi-cash me-1"></i>Tiền mặt</label>

                            <input type="radio" class="btn-check" name="payTypeRadio" id="payQrRadio" value="VietQR" onchange="onPaymentTypeChange()" />
                            <label class="btn btn-outline-info btn-sm" for="payQrRadio"><i class="bi bi-qr-code me-1"></i>VietQR [F8]</label>

                            <input type="radio" class="btn-check" name="payTypeRadio" id="payCardRadio" value="BankCard" onchange="onPaymentTypeChange()" />
                            <label class="btn btn-outline-primary btn-sm" for="payCardRadio"><i class="bi bi-credit-card me-1"></i>Quẹt thẻ</label>
                        </div>

                        <!-- Khách đưa tiền mặt -->
                        <div id="cashPaymentGroup">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">Khách đưa:</span>
                                <input type="number" id="cashGivenInput" class="form-control text-end fs-5 fw-bold text-success" style="width: 170px;" step="1000" value="0" oninput="calcChange()" />
                            </div>
                            <div class="d-flex gap-1 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="setCashGiven('exact')">Đúng tiền</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="setCashGiven(100000)">100k</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="setCashGiven(200000)">200k</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="setCashGiven(500000)">500k</button>
                            </div>
                            <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded">
                                <span class="small fw-semibold">Tiền thừa trả khách:</span>
                                <span class="fs-5 fw-bold text-danger" id="cashChangeText">0 ₫</span>
                            </div>
                        </div>

                        <!-- VietQR Payment Info -->
                        <div id="qrPaymentGroup" class="d-none text-center bg-light p-3 rounded">
                            <span class="badge bg-info text-dark mb-2">Mã thanh toán VietQR động</span>
                            <div id="vietQrBox" class="border p-2 bg-white rounded d-inline-block">
                                <img id="vietQrImg" src="" alt="VietQR" style="width: 170px; height: 170px;" />
                            </div>
                            <small class="d-block text-muted mt-1">Quét bằng ứng dụng Ngân hàng (VCB, TCB, MB, MoMo...)</small>
                        </div>
                    </div>

                    <div class="mt-auto">
                        <button type="button" class="btn btn-success w-100 py-3 fs-4 fw-bold shadow" id="btnCheckout" onclick="submitCheckout()">
                            <i class="bi bi-check2-circle me-1"></i> THANH TOÁN [F9]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Khách hàng mới nhanh -->
<div class="modal fade" id="quickCustomerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus text-primary me-2"></i>Thêm nhanh Khách hàng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                    <input type="text" id="newCustName" class="form-control" placeholder="VD: Trần Văn Nam" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <input type="text" id="newCustPhone" class="form-control" placeholder="090..." required />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary fw-semibold" onclick="submitNewCustomer()">
                    <i class="bi bi-save me-1"></i> Tạo thành viên
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal In Hóa đơn -->
<div class="modal fade" id="receiptModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 bg-light">
                <h6 class="modal-title fw-bold"><i class="bi bi-printer text-primary me-2"></i>Hóa đơn bán hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="resetAfterReceipt()"></button>
            </div>
            <div class="modal-body p-0" id="receiptPrintArea"></div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" onclick="resetAfterReceipt()">Đóng [Esc]</button>
                <button type="button" class="btn btn-primary fw-semibold" onclick="printReceipt()">
                    <i class="bi bi-printer-fill me-1"></i> In hóa đơn (80mm)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // State variables
        const warehouseId = '@warehouse?.Id';
        const shiftSessionId = '@shift?.Id';
        const storeId = '@shift?.StoreId';
        let cart = [];
        let currentCustomer = null;
        let selectedPaymentMethod = 'Cash';

        // Realtime clock
        setInterval(() => {
            const now = new Date();
            document.getElementById('posClock').innerText = now.toLocaleTimeString('vi-VN');
        }, 1000);

        // Barcode Scanner & Enter Key Listener
        const scannerInput = document.getElementById('barcodeScannerInput');
        scannerInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const term = this.value.trim();
                if (term) {
                    processBarcodeScan(term);
                }
            }
        });

        document.getElementById('btnSearchProduct').addEventListener('click', function () {
            processBarcodeScan(scannerInput.value.trim());
        });

        async function processBarcodeScan(term) {
            if (!term) return;
            try {
                const response = await fetch(`/POS/Terminal/SearchProducts?warehouseId=${warehouseId}&keyword=${encodeURIComponent(term)}`);
                const products = await response.json();

                if (!products || products.length === 0) {
                    alert(`Không tìm thấy sản phẩm nào khớp với mã "${term}" trong kho.`);
                    scannerInput.select();
                    return;
                }

                if (products.length === 1) {
                    // Trùng khớp chính xác 1 sản phẩm -> Tự động thêm vào giỏ
                    addToCart(products[0]);
                    scannerInput.value = '';
                    scannerInput.focus();
                } else {
                    // Nhiều sản phẩm -> Hiển thị danh sách gợi ý
                    renderSearchDropdown(products);
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi tìm kiếm sản phẩm: ' + err.message);
            }
        }

        function renderSearchDropdown(products) {
            const dropdown = document.getElementById('searchDropdown');
            const list = document.getElementById('searchResultList');
            list.innerHTML = '';

            products.forEach(p => {
                const item = document.createElement('a');
                item.href = 'javascript:void(0)';
                item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2';
                item.innerHTML = `
                    <div>
                        <div class="fw-semibold">${p.title}</div>
                        <small class="text-muted">SKU: <code>${p.sku}</code> | Tồn: <strong>${p.availableStock}</strong> ${p.unit}</small>
                    </div>
                    <span class="fs-6 fw-bold text-primary">${p.sellingPrice.toLocaleString('vi-VN')} ₫</span>
                `;
                item.onclick = () => {
                    addToCart(p);
                    dropdown.classList.add('d-none');
                    scannerInput.value = '';
                    scannerInput.focus();
                };
                list.appendChild(item);
            });

            dropdown.classList.remove('d-none');
        }

        // Click outside closes dropdown
        document.addEventListener('click', function (e) {
            const dropdown = document.getElementById('searchDropdown');
            if (!dropdown.contains(e.target) && e.target !== scannerInput) {
                dropdown.classList.add('d-none');
            }
        });

        // Cart functions
        function addToCart(product, qty = 1) {
            const existing = cart.find(i => i.productId === product.id);
            if (existing) {
                existing.quantity += qty;
            } else {
                cart.push({
                    productId: product.id,
                    sku: product.sku,
                    barcode: product.barcode,
                    title: product.title,
                    unitPrice: product.sellingPrice,
                    quantity: qty,
                    discountAmount: 0
                });
            }
            renderCart();
        }

        function updateCartQty(index, newQty) {
            if (newQty <= 0) {
                removeFromCart(index);
                return;
            }
            cart[index].quantity = newQty;
            renderCart();
        }

        function updateCartDiscount(index, discount) {
            cart[index].discountAmount = Math.max(0, discount);
            renderCart();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
        }

        function clearCart() {
            if (cart.length === 0) return;
            if (confirm('Làm trống toàn bộ giỏ hàng?')) {
                cart = [];
                renderCart();
                scannerInput.focus();
            }
        }

        function renderCart() {
            const tbody = document.getElementById('cartTableBody');
            const countBadge = document.getElementById('cartCountBadge');
            countBadge.innerText = cart.length;

            if (cart.length === 0) {
                tbody.innerHTML = `
                    <tr id="emptyCartRow">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                            Giỏ hàng đang trống. Vui lòng quét mã vạch sản phẩm để thêm vào đơn.
                        </td>
                    </tr>
                `;
                recalculateTotals();
                return;
            }

            tbody.innerHTML = '';
            cart.forEach((item, index) => {
                const lineTotal = (item.quantity * item.unitPrice) - item.discountAmount;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center text-muted">${index + 1}</td>
                    <td>
                        <div class="fw-semibold">${item.title}</div>
                        <small class="text-muted"><code>${item.sku}</code></small>
                    </td>
                    <td class="text-end">${item.unitPrice.toLocaleString('vi-VN')} ₫</td>
                    <td class="text-center">
                        <div class="input-group input-group-sm justify-content-center" style="width: 120px; margin: 0 auto;">
                            <button class="btn btn-outline-secondary" type="button" onclick="updateCartQty(${index}, ${item.quantity - 1})">-</button>
                            <input type="number" class="form-control text-center" value="${item.quantity}" min="1" onchange="updateCartQty(${index}, parseFloat(this.value) || 1)" />
                            <button class="btn btn-outline-secondary" type="button" onclick="updateCartQty(${index}, ${item.quantity + 1})">+</button>
                        </div>
                    </td>
                    <td class="text-end">
                        <input type="number" class="form-control form-control-sm text-end" value="${item.discountAmount}" min="0" step="1000" onchange="updateCartDiscount(${index}, parseFloat(this.value) || 0)" />
                    </td>
                    <td class="text-end fw-bold text-primary">${lineTotal.toLocaleString('vi-VN')} ₫</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removeFromCart(${index})">
                            <i class="bi bi-x-circle fs-5"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            recalculateTotals();
        }

        function recalculateTotals() {
            let subTotal = 0;
            cart.forEach(item => {
                subTotal += (item.quantity * item.unitPrice) - item.discountAmount;
            });

            const directDiscount = parseFloat(document.getElementById('directDiscountInput').value) || 0;
            const pointsToRedeem = parseInt(document.getElementById('redeemPointsInput')?.value) || 0;
            const loyaltyDiscount = pointsToRedeem * 1000;

            const finalTotal = Math.max(0, subTotal - directDiscount - loyaltyDiscount);

            document.getElementById('subTotalText').innerText = subTotal.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('loyaltyDiscountText').innerText = '-' + loyaltyDiscount.toLocaleString('vi-VN') + ' ₫';
            document.getElementById('finalTotalText').innerText = finalTotal.toLocaleString('vi-VN') + ' ₫';

            // Auto-update cash given if exact
            const cashGivenInput = document.getElementById('cashGivenInput');
            if (selectedPaymentMethod === 'Cash' && (cashGivenInput.value === '0' || parseFloat(cashGivenInput.value) < finalTotal)) {
                cashGivenInput.value = finalTotal;
            }
            calcChange();
            updateVietQr(finalTotal);
        }

        // Customer handlers
        async function searchCustomer() {
            const phone = document.getElementById('customerPhoneInput').value.trim();
            if (!phone) return;
            try {
                const res = await fetch(`/POS/Terminal/LookupCustomer?phone=${encodeURIComponent(phone)}`);
                const cust = await res.json();
                if (!cust) {
                    alert('Không tìm thấy thành viên với số điện thoại này. Bạn có thể bấm "+ Khách mới" để tạo nhanh.');
                    return;
                }
                setCustomer(cust);
            } catch (err) {
                alert('Lỗi tra cứu khách hàng: ' + err.message);
            }
        }

        function setCustomer(cust) {
            currentCustomer = cust;
            document.getElementById('custNameText').innerText = cust.name;
            document.getElementById('custPhoneText').innerText = cust.phone;
            document.getElementById('custPointsText').innerText = cust.points.toLocaleString('vi-VN');
            document.getElementById('custTierBadge').innerText = cust.tier;
            document.getElementById('customerInfoBox').classList.remove('d-none');
            document.getElementById('redeemPointsInput').max = cust.points;
            document.getElementById('redeemPointsInput').value = 0;
            onRedeemPointsChange();
        }

        function clearCustomer() {
            currentCustomer = null;
            document.getElementById('customerInfoBox').classList.add('d-none');
            document.getElementById('customerPhoneInput').value = '';
            document.getElementById('redeemPointsInput').value = 0;
            onRedeemPointsChange();
        }

        function onRedeemPointsChange() {
            const input = document.getElementById('redeemPointsInput');
            let points = parseInt(input.value) || 0;
            if (currentCustomer && points > currentCustomer.points) {
                points = currentCustomer.points;
                input.value = points;
            }
            document.getElementById('redeemValueText').innerText = (points * 1000).toLocaleString('vi-VN') + ' ₫';
            recalculateTotals();
        }

        async function submitNewCustomer() {
            const name = document.getElementById('newCustName').value.trim();
            const phone = document.getElementById('newCustPhone').value.trim();
            if (!name || !phone) {
                alert('Vui lòng nhập tên và số điện thoại.');
                return;
            }

            try {
                const res = await fetch(`/POS/Terminal/QuickCreateCustomer?fullName=${encodeURIComponent(name)}&phone=${encodeURIComponent(phone)}`, {
                    method: 'POST'
                });
                if (!res.ok) throw new Error(await res.text());
                const cust = await res.json();
                setCustomer(cust);
                const modal = bootstrap.Modal.getInstance(document.getElementById('quickCustomerModal'));
                if (modal) modal.hide();
            } catch (err) {
                alert('Lỗi: ' + err.message);
            }
        }

        // Payment handlers
        function onPaymentTypeChange() {
            const radios = document.getElementsByName('payTypeRadio');
            for (let r of radios) {
                if (r.checked) {
                    selectedPaymentMethod = r.value;
                    break;
                }
            }

            const cashGroup = document.getElementById('cashPaymentGroup');
            const qrGroup = document.getElementById('qrPaymentGroup');

            if (selectedPaymentMethod === 'Cash') {
                cashGroup.classList.remove('d-none');
                qrGroup.classList.add('d-none');
            } else if (selectedPaymentMethod === 'VietQR') {
                cashGroup.classList.add('d-none');
                qrGroup.classList.remove('d-none');
            } else {
                cashGroup.classList.add('d-none');
                qrGroup.classList.add('d-none');
            }
            recalculateTotals();
        }

        function setCashGiven(amount) {
            let total = 0;
            cart.forEach(i => total += (i.quantity * i.unitPrice) - i.discountAmount);
            const directDiscount = parseFloat(document.getElementById('directDiscountInput').value) || 0;
            const pointsDiscount = (parseInt(document.getElementById('redeemPointsInput')?.value) || 0) * 1000;
            const final = Math.max(0, total - directDiscount - pointsDiscount);

            if (amount === 'exact') {
                document.getElementById('cashGivenInput').value = final;
            } else {
                document.getElementById('cashGivenInput').value = amount;
            }
            calcChange();
        }

        function calcChange() {
            let total = 0;
            cart.forEach(i => total += (i.quantity * i.unitPrice) - i.discountAmount);
            const directDiscount = parseFloat(document.getElementById('directDiscountInput').value) || 0;
            const pointsDiscount = (parseInt(document.getElementById('redeemPointsInput')?.value) || 0) * 1000;
            const final = Math.max(0, total - directDiscount - pointsDiscount);

            const cashGiven = parseFloat(document.getElementById('cashGivenInput').value) || 0;
            const change = Math.max(0, cashGiven - final);
            document.getElementById('cashChangeText').innerText = change.toLocaleString('vi-VN') + ' ₫';
        }

        function updateVietQr(amount) {
            if (amount <= 0) return;
            // Dùng API VietQR công khai để tạo mã QR động: https://img.vietqr.io/image/{bankId}-{accountNo}-compact2.png?amount={amount}&addInfo={info}
            const bankId = 'VCB';
            const accountNo = '9876543210';
            const info = encodeURIComponent(`ABC POS ${shiftSessionId.substring(0, 8)}`);
            const qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-compact2.png?amount=${amount}&addInfo=${info}`;
            document.getElementById('vietQrImg').src = qrUrl;
        }

        // Checkout submission
        async function submitCheckout() {
            if (cart.length === 0) {
                alert('Giỏ hàng đang trống. Vui lòng quét sản phẩm trước khi thanh toán.');
                return;
            }

            let subTotal = 0;
            cart.forEach(i => subTotal += (i.quantity * i.unitPrice) - i.discountAmount);
            const directDiscount = parseFloat(document.getElementById('directDiscountInput').value) || 0;
            const pointsToRedeem = parseInt(document.getElementById('redeemPointsInput')?.value) || 0;
            const finalTotal = Math.max(0, subTotal - directDiscount - (pointsToRedeem * 1000));

            let payments = [];
            if (selectedPaymentMethod === 'Cash') {
                const cashGiven = parseFloat(document.getElementById('cashGivenInput').value) || 0;
                if (cashGiven < finalTotal) {
                    alert(`Tiền mặt khách đưa (${cashGiven.toLocaleString('vi-VN')} ₫) chưa đủ tổng tiền đơn (${finalTotal.toLocaleString('vi-VN')} ₫).`);
                    return;
                }
                payments.push({
                    paymentMethod: 1, // Cash
                    amount: cashGiven,
                    transactionReference: ''
                });
            } else if (selectedPaymentMethod === 'VietQR') {
                payments.push({
                    paymentMethod: 2, // VietQR
                    amount: finalTotal,
                    transactionReference: `VQR-${Date.now()}`
                });
            } else if (selectedPaymentMethod === 'BankCard') {
                payments.push({
                    paymentMethod: 3, // BankCard
                    amount: finalTotal,
                    transactionReference: `CARD-${Date.now()}`
                });
            }

            const checkoutDto = {
                shiftSessionId: shiftSessionId,
                storeId: storeId,
                warehouseId: warehouseId,
                customerId: currentCustomer ? currentCustomer.id : null,
                idempotencyKey: 'IDEM-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8),
                discountAmount: directDiscount,
                pointsToRedeem: pointsToRedeem,
                items: cart.map(i => ({
                    productId: i.productId,
                    quantity: i.quantity,
                    unitPrice: i.unitPrice,
                    discountAmount: i.discountAmount
                })),
                payments: payments
            };

            const btn = document.getElementById('btnCheckout');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';

            try {
                const res = await fetch('/POS/Terminal/Checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(checkoutDto)
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Lỗi xử lý thanh toán');
                }

                // Thành công: Hiển thị hóa đơn
                showReceiptModal(data.receipt.orderId);
            } catch (err) {
                alert('Thanh toán thất bại: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> THANH TOÁN [F9]';
            }
        }

        async function showReceiptModal(orderId) {
            try {
                const res = await fetch(`/POS/Terminal/Receipt/${orderId}`);
                const html = await res.text();
                document.getElementById('receiptPrintArea').innerHTML = html;
                const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
                modal.show();
            } catch (err) {
                console.error(err);
            }
        }

        function printReceipt() {
            window.print();
        }

        function resetAfterReceipt() {
            cart = [];
            clearCustomer();
            document.getElementById('directDiscountInput').value = 0;
            renderCart();
            scannerInput.value = '';
            scannerInput.focus();
        }

        // Global Keyboard Shortcuts
        document.addEventListener('keydown', function (e) {
            if (e.key === 'F2') {
                e.preventDefault();
                scannerInput.focus();
                scannerInput.select();
            } else if (e.key === 'F4') {
                e.preventDefault();
                document.getElementById('customerPhoneInput').focus();
            } else if (e.key === 'F8') {
                e.preventDefault();
                document.getElementById('payQrRadio').checked = true;
                onPaymentTypeChange();
            } else if (e.key === 'F9') {
                e.preventDefault();
                submitCheckout();
            }
        });
    </script>
}
